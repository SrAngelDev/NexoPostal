{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_INTRANET_HOST};Port=${POSTGRES_INTRANET_PORT};Database=${POSTGRES_INTRANET_DB};Username=${POSTGRES_INTRANET_USER};Password=${POSTGRES_INTRANET_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryMinutes": "${JWT_EXPIRY_MINUTES}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InterServiceSettings": {
    "ServiceKey": "${INTER_SERVICE_KEY}"
  },
  "RepartoSettings": {
    "BaseUrl": "${REPARTO_BASE_URL}",
    "ServiceKey": "${INTER_SERVICE_KEY}"
  },
  "CiudadanoSettings": {
    "BaseUrl": "${URL_MODULO_CIUDADANO}",
    "ServiceKey": "${INTER_SERVICE_KEY}"
  }
}
