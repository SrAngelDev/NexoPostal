{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_AUTH_HOST};Port=${POSTGRES_AUTH_PORT};Database=${POSTGRES_AUTH_DB};Username=${POSTGRES_AUTH_USER};Password=${POSTGRES_AUTH_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryMinutes": "${JWT_EXPIRY_MINUTES}",
    "RefreshExpiryDays": "${JWT_REFRESH_EXPIRY_DAYS}"
  },
  "AppSettings": {
    "FrontendUrl": "${FRONTEND_URL}"
  },
  "Email": {
    "SmtpHost": "${SMTP_HOST}",
    "SmtpPort": "${SMTP_PORT}",
    "SmtpUser": "${SMTP_USER}",
    "SmtpPass": "${SMTP_PASS}",
    "From": "${SMTP_FROM}",
    "FromName": "NexoPostal"
  },
  "InterServiceSettings": {
    "ServiceKey": "${INTER_SERVICE_KEY}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}