{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_CIUDADANO_HOST};Port=${POSTGRES_CIUDADANO_PORT};Database=${POSTGRES_CIUDADANO_DB};Username=${POSTGRES_CIUDADANO_USER};Password=${POSTGRES_CIUDADANO_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryMinutes": "${JWT_EXPIRY_MINUTES}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stripe": {
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}"
  },
  "SmtpSettings": {
    "Host": "${SMTP_HOST}",
    "Port": "${SMTP_PORT}",
    "UseSsl": "${SMTP_USESSL}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromName": "${SMTP_FROM_NAME}",
    "FromEmail": "${SMTP_FROM_EMAIL}"
  },
  "IntranetSettings": {
    "BaseUrl": "${INTRANET_BASE_URL}",
    "ServiceKey": "${INTER_SERVICE_KEY}"
  }
}
