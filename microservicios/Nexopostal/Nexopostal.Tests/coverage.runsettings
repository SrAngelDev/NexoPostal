<?xml version="1.0" encoding="utf-8" ?>
<!--
  Configuracion de cobertura de codigo para Coverlet (DataCollector).
  Uso: dotnet test -settings coverage.runsettings -collect "XPlat Code Coverage"

  Solo se instrumentan los ensamblados de produccion de NexoPostal.
  Se excluyen los proyectos de tests, migraciones, hubs SignalR, seeders,
  Program bootstrap y todo codigo autogenerado.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Nexopostal.Auth]*,[Nexopostal.Ciudadano]*,[Nexopostal.Intranet]*,[Nexopostal.Reparto]*,[Nexopostal.Gateway]*,[Nexopostal.Shared]*</Include>
          <Exclude>[Nexopostal.Tests]*,[Nexopostal.Tests.E2E]*,[*.Tests]*,[*Tests*]*,[*]Microsoft.AspNetCore.OpenApi.Generated.*,[*]*.Migrations.*,[*]Program,[*]*+&lt;&gt;c*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,ObsoleteAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/**/*.cs,**/obj/**/*.cs,**/Hubs/*Hub.cs,**/Data/*DataSeeder.cs,**/Program.cs,**/*.g.cs,**/*.generated.cs</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
