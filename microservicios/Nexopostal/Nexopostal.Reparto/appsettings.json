{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_REPARTO_HOST};Port=${POSTGRES_REPARTO_PORT};Database=${POSTGRES_REPARTO_DB};Username=${POSTGRES_REPARTO_USER};Password=${POSTGRES_REPARTO_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryMinutes": "${JWT_EXPIRY_MINUTES}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
