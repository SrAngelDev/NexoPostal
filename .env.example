# ============================================
# NEXOPOSTAL — PLANTILLA DE VARIABLES DE ENTORNO
# ============================================
# Copia este archivo a .env y configura los valores
# cp .env.example .env

# ============================================
# ENTORNO
# ============================================
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# DOMINIOS (desarrollo local)
# ============================================
DOMINIO_CLIENTES=localhost
DOMINIO_INTRANET=localhost:4202
DOMINIO_DRIVER=localhost:4201

# URL pública del frontend de clientes (usada en emails de recuperación de contraseña)
# Local:      http://localhost
# Producción: https://nexopostal.es
FRONTEND_URL=http://localhost

# URLs de los servicios
URL_MODULO_SEGURIDAD=http://modulo-seguridad:80
URL_MODULO_CIUDADANO=http://modulo-ciudadano:80
URL_MODULO_LOGISTICA=http://modulo-logistica:80
URL_MODULO_REPARTO=http://modulo-reparto:80
URL_API_GATEWAY=http://api-gateway:80

# ============================================
# JWT - AUTENTICACIÓN
# ============================================
# Genera una clave segura con: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_KEY=ESTA_ES_MI_CLAVE_SECRETA_MUY_LARGA_PARA_NEXOPOSTAL_DEBE_SER_MINIMO_32_CARACTERES
JWT_ISSUER=NexoPostal.Auth
JWT_AUDIENCE=nexopostal-api
JWT_EXPIRY_MINUTES=60

# ============================================
# BASES DE DATOS (desarrollo)
# ============================================
POSTGRES_AUTH_HOST=postgres-auth
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DB=nexopostal_auth
POSTGRES_AUTH_USER=postgres
POSTGRES_AUTH_PASSWORD=postgres

POSTGRES_CIUDADANO_HOST=postgres-ciudadano
POSTGRES_CIUDADANO_PORT=5432
POSTGRES_CIUDADANO_DB=nexopostal_ciudadano
POSTGRES_CIUDADANO_USER=postgres
POSTGRES_CIUDADANO_PASSWORD=postgres

POSTGRES_INTRANET_HOST=postgres-intranet
POSTGRES_INTRANET_PORT=5432
POSTGRES_INTRANET_DB=nexopostal_intranet
POSTGRES_INTRANET_USER=postgres
POSTGRES_INTRANET_PASSWORD=postgres

POSTGRES_REPARTO_HOST=postgres-reparto
POSTGRES_REPARTO_PORT=5432
POSTGRES_REPARTO_DB=nexopostal_reparto
POSTGRES_REPARTO_USER=postgres
POSTGRES_REPARTO_PASSWORD=postgres

# ============================================
# stripe (DESARROLLO - NO USAR EN PRODUCCIÓN)
# ============================================
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_STRIPE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# ============================================
# EMAIL (DESARROLLO)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USESSL=true
SMTP_USERNAME=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
SMTP_FROM_NAME=NexoPostal
SMTP_FROM_EMAIL=no-reply@nexopostal.es

# ============================================
# COMUNICACIÓN INTER-SERVICIOS
# ============================================
INTER_SERVICE_KEY=nexopostal-internal-service-key-2025
INTRANET_BASE_URL=http://modulo-logistica:80

# ============================================
# PUERTOS
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# SEGURIDAD
# ============================================
ENABLE_SWAGGER=true
LOG_LEVEL=Information